      },
      "h2": {
        "$value": "{core.fontSizes.h3} * 1.25",
        "$type": "fontSizes"
      },
      "h3": {
        "$value": "{core.fontSizes.h4} * 1.25",
        "$type": "fontSizes"
      },
      "h4": {
        "$value": "{core.fontSizes.h5} * 1.25",
        "$type": "fontSizes"
