{
  "core": {
    "dimension": {
      "scale": {
        "$value": "2",
        "$type": "dimension"
      },
      "xxs": {
        "$value": "1px",
        "$type": "dimension"
      },
      "xs": {
        "$value": "{core.dimension.xxs} * {core.dimension.scale}",
        "$type": "dimension"
      },
      "sm": {
        "$value": "{core.dimension.xs} * {core.dimension.scale}",
        "$type": "dimension"
      },
      "md": {
        "$value": "{core.dimension.sm} * {core.dimension.scale}",
        "$type": "dimension"
      },
      "lg": {
        "$value": "{core.dimension.md} * {core.dimension.scale}",
        "$type": "dimension"
      },
      "xl": {
        "$value": "{core.dimension.lg} * {core.dimension.scale}",
        "$type": "dimension"
      },
      "xxl": {
        "$value": "{core.dimension.xl} * {core.dimension.scale}",
        "$type": "dimension"
      }
    },
    "spacing": {
      "xs": {
        "$value": "{core.dimension.xs}",
