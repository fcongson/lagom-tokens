{
  "name": "lagom-tokens-monorepo",
  "private": true,
  "author": "Frank Congson",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fcongson/lagom-tokens"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ramps": "node scripts/ramps.js",
    "ramps:check": "node scripts/ramps.js --check",
    "build": "node scripts/build.js",
    "check-brand": "node scripts/check-brand.js",
    "suggest-more": "node scripts/suggest-more.js",
    "verify": "node scripts/verify.js",
    "test:cascade": "node test/cascade.test.js",
    "migrate": "node scripts/migrate.js",
    "ci": "yarn ramps:check && yarn build && yarn check-brand && node scripts/check-brand.js examples/white-label.css && yarn verify && yarn test:cascade"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
